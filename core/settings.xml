<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <!--
        Our rows in the settings list. The list pools its row frames by template, and
        rows built from addon settings leave the frames they used tainted: a Blizzard
        row reusing one then runs tainted, and its protected calls are blocked (e.g. the
        Discord voice option on the Audio page). Our own template names give our rows
        frames of their own.
    -->
    <Frame name="ForeverEnhancedSettingsSectionHeaderTemplate" inherits="SettingsListSectionHeaderTemplate" virtual="true"/>
    <Frame name="ForeverEnhancedSettingsCheckboxControlTemplate" inherits="SettingsCheckboxControlTemplate" virtual="true"/>
    <Frame name="ForeverEnhancedSettingsDropdownControlTemplate" inherits="SettingsDropdownControlTemplate" virtual="true"/>
    <Frame name="ForeverEnhancedSettingsSliderControlTemplate" inherits="SettingsSliderControlTemplate" virtual="true"/>

    <!-- Text setting row (the `text` schema type): see TextControlMixin in settings.lua. -->
    <Frame name="ForeverEnhancedSettingsTextControlTemplate" inherits="SettingsListElementTemplate" virtual="true">
        <Size x="280" y="26"/>
        <Scripts>
            <OnLoad>
                Mixin(self, SettingsControlMixin, ForeverEnhanced.SettingsPanel.TextControlMixin)
                self:OnLoad()
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>
